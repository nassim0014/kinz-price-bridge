# kinz-price-bridge — .dockerignore

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Data (never bake into the image)
data/
*.db
*.sqlite3

# Git
.git/
.gitignore

# Docs (not needed at runtime)
README.md
CLAUDE.md
docs/
